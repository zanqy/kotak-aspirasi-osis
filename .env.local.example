# ===== Firebase (ganti dengan nilai dari Firebase Console) =====
# Web API Key: Project settings → General → Web API Key
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
# Project ID: Project settings → General → Project ID
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Server-only (Project settings → Service accounts → Generate new private key)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ===== Resend =====
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# ===== Admin default (referensi untuk membuat user admin di Firestore) =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password

# ===== App =====
NEXT_PUBLIC_APP_URL=http://localhost:3000